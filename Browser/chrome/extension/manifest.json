{
  "manifest_version": 3,
  "name": "keydillo",
  "description": "Lets Claude use Chrome through keydillo, which hides passwords and API keys from it.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "management", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "keydillo", "default_popup": "popup.html" }
}
