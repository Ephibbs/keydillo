{
  "description": "keydillo: say when the app is missing, and stop direct calls that would send a placeholder or skip the proxy",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/keydillo-cli\" --check-installed", "timeout": 5 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|WebFetch", "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/keydillo-cli\" hook", "timeout": 5 } ] }
    ]
  }
}
